# ============================================================
# enterprise-copilot 配置模板：复制为 .env 后填入真实值
# ============================================================

# ===== 对话模型（OpenAI 兼容：DeepSeek / 硅基流动 / 本地 vLLM） =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0

# 本地 vLLM 切换示例：
# LLM_BASE_URL=http://localhost:28080/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen2.5-7B-Instruct

# ===== Embedding / Rerank =====
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-your-embedding-key
EMBED_MODEL=BAAI/bge-large-zh-v1.5
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-your-rerank-key
RERANK_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANK=true

# ===== RAG 检索参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
RETRIEVE_CANDIDATES=10
# 重排相关性阈值：top_k 分数全低于该值时直接拒答（防幻觉第一道闸）
RELEVANCE_THRESHOLD=0.3
# 单文件上传大小上限（MB），超限返回 413
MAX_UPLOAD_MB=50
HISTORY_TURNS=3
HISTORY_MAX_MSGS=10

# ===== RAG Small-to-Big 父子分块 =====
# 开启后小块(200)检索 + 父块(1000)喂 LLM；关闭回退单层 500 分块
USE_PARENT_CHILD=true
PARENT_CHUNK_SIZE=1000
CHILD_CHUNK_SIZE=200
CHILD_CHUNK_OVERLAP=50

# ===== RAG 扫描版 PDF OCR 兜底 =====
ENABLE_OCR=true
OCR_MIN_CHARS=10
OCR_DPI=200

# ===== RAG 外部 API 指数退避重试 =====
# 429/5xx/网络异常自动重试，指数退避+全抖动；4xx(除429)不重试
API_MAX_RETRIES=3
API_RETRY_BASE_DELAY=1.0
API_RETRY_MAX_DELAY=30.0

# ===== Text-to-SQL =====
DB_PATH=data/db/ic_substrate.db
# 兜底基准日：仅当运行时 MAX(业务日期) 探测全部失败时回退使用（正常锚点动态探测）
ANCHOR_DATE=2026-09-24
# 动态锚点缓存秒数（数据按天滚动，默认 5 分钟跟进；0 = 每次现查）
ANCHOR_TTL_SECONDS=300
# 应收账龄快照日：留空 = 跟随动态锚点（生产语义）；显式设置则固定（如 2026-10-31 演示逾期）
SNAPSHOT_DATE=

# ===== 运行期目录 =====
DATA_DIR=data
CHROMA_DIR=data/chroma
UPLOADS_DIR=data/uploads
TMP_DIR=data/tmp
OUTPUT_DIR=data/output

# ===== 端口 =====
GATEWAY_PORT=8000
RAG_PORT=8001
AGENT_PORT=8002
SQL_PORT=8010
SERVER_HOST=127.0.0.1
SERVER_PORT=8010

# ===== 网关认证（可选） =====
# 留空 = 不启用认证；支持逗号分隔多个密钥，业务接口需带 X-API-Key 或 Authorization: Bearer
GATEWAY_API_KEY=
