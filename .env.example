# ============================================================
# enterprise-copilot 配置模板：复制为 .env 后填入真实值
# ============================================================

# ===== 对话模型（OpenAI 兼容：DeepSeek / 硅基流动 / 本地 vLLM） =====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60
LLM_TEMPERATURE=0

# 本地 vLLM 切换示例：
# LLM_BASE_URL=http://localhost:28080/v1
# LLM_API_KEY=EMPTY
# LLM_MODEL=Qwen2.5-7B-Instruct

# ===== Embedding / Rerank =====
EMBED_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_KEY=sk-your-embedding-key
EMBED_MODEL=BAAI/bge-large-zh-v1.5
RERANK_BASE_URL=https://api.siliconflow.cn/v1
RERANK_API_KEY=sk-your-rerank-key
RERANK_MODEL=BAAI/bge-reranker-v2-m3
USE_RERANK=true

# ===== RAG 检索参数 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
RETRIEVE_CANDIDATES=10
HISTORY_TURNS=3
HISTORY_MAX_MSGS=10

# ===== Text-to-SQL =====
DB_PATH=data/db/ic_substrate.db
ANCHOR_DATE=2026-09-24
SNAPSHOT_DATE=2026-09-24

# ===== 运行期目录 =====
DATA_DIR=data
CHROMA_DIR=data/chroma
UPLOADS_DIR=data/uploads
TMP_DIR=data/tmp
OUTPUT_DIR=data/output

# ===== 端口 =====
GATEWAY_PORT=8000
RAG_PORT=8001
AGENT_PORT=8002
SQL_PORT=8010
SERVER_HOST=127.0.0.1
SERVER_PORT=8010

# ===== 网关认证（可选） =====
# 留空 = 不启用认证；支持逗号分隔多个密钥，业务接口需带 X-API-Key 或 Authorization: Bearer
GATEWAY_API_KEY=
